{
  "mcp": {
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": true
    },
    "trivy": {
      "type": "local",
      "command": [
        "trivy",
        "mcp",
        "--trivy-binary",
        "/home/linuxbrew/.linuxbrew/bin/trivy"
      ],
      "enabled": true
    }
  }
}
