<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title></title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
    <script src="start.js"></script>
  </head>
  <body>
    <main class="flex flex-row items-center justify-center h-screen">
      <div class="w-[30%] h-full flex flex-col">
        <textarea id="data-text-area" class="h-full w-full border-2 border-red-300" value='' ></textarea>
        <textarea id='style-text-area' class="h-full w-full border-2 border-blue-300" value='' ></textarea>
        <textarea id='object-text-area' class="h-full w-full border-2 border-orange-300" value='' ></textarea>
        <li id="row" class="bg-blue-500 text-white px-4 py-2 rounded-md" ondragstart="dragstartHandler(event)" draggable="true">row</li>
        <li id="col" class="bg-red-500 text-white px-4 py-2 rounded-md" ondragstart="dragstartHandler(event)" draggable="true">col</li>
      </div>
      <div class='w-full h-full'>
        <div id="frame" class="flex flex-col w-full h-screen" ondrop="dropHandler(event)" ondragover="dragoverHandler(event)" ondragleave="dragLeaveHandler(event)" ondragenter="dragEnterHandler(event)" onchange="frameChange(event)">
        </div>
      </div>
    </main> 
    <script type="module" src="script.js"></script>
  </body>
</html>
