<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Layout Builder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-7xl mx-auto grid grid-cols-12 gap-8">
        <!-- Panel de Componentes -->
        <div class="col-span-3 bg-white p-6 rounded-xl shadow-lg h-[80vh] overflow-y-auto">
            <h2 class="text-xl font-bold mb-6 text-gray-800">Componentes</h2>
            <div id="componentes" class="space-y-3">
            </div>
        </div>

        <div class="col-span-6 bg-white p-8 rounded-xl shadow-lg h-[80vh] overflow-auto border-4 border-dashed border-gray-300" 
             id="dropzone"
             ondragover="onDragOver(event)" 
             ondrop="onDrop(event)">
            <div id="preview" class="min-h-full">
            </div>
        </div>

        <div class="col-span-3 bg-white p-6 rounded-xl shadow-lg h-[80vh] overflow-auto">
            <h2 class="text-xl font-bold mb-4 text-gray-800">Schema</h2>
            <pre id="schema-display" class="bg-gray-50 p-4 rounded-lg text-sm font-mono text-gray-700 overflow-auto text-xs"></pre>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
